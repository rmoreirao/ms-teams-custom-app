# Optional real Entra/Teams validation only. Offline tests never load this file.
# Use an explicitly approved HTTPS OIDC origin; do not add localhost redirects.
REFERENCE_BASE_URL=https://your-dev-origin.example
ENTRA_TEST_BROWSER=chromium
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# live = existing five delegated Teams scopes; live-delegated additionally pins
# the already-consented Chat.Create scope, without enabling creation in the app.
# Historical graph-pilot / graph-pilot-direct helper aliases map exactly to these.
ENTRA_AUTH_PROFILE=live-delegated
ENTRA_DEFER_OPTIONAL_REGISTRATION=false
# Rename private PILOT_VALIDATION_SETTINGS to LIVE_VALIDATION_SETTINGS and migrate
# metadata to schemaVersion 2: retain tenantId/webClientId/origin/three actors and
# the exact five existing graph-pilot-* resource IDs (group, channel, three pairs).
# Optional authProfile: live or live-delegated (default). directChatsEnabled only
# opts into reusing already-approved pairs; never create resources or regrant consent.
LIVE_VALIDATION_SETTINGS=
ENTRA_EXPECTED_ACTOR_ID=
ENTRA_EXPECTED_USERNAME=
TEST_ALEX_USER=
TEST_ALEX_PASSWORD=""
TEST_ALEX_TOTP_SECRET=""
TEST_SAM_USER=
TEST_SAM_PASSWORD=""
TEST_SAM_TOTP_SECRET=""
TEST_JORDAN_USER=
TEST_JORDAN_PASSWORD=""
TEST_JORDAN_TOTP_SECRET=""
