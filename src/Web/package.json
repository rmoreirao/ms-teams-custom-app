{
  "name": "teams-reference-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test:e2e": "playwright test",
    "test:prototypes": "playwright test --config playwright.prototypes.config.ts",
    "check:entra": "tsc --project tsconfig.entra.json",
    "test:entra:unit": "node --test scripts/entra-signin.test.mjs",
    "test:entra": "node scripts/check-entra-signin.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/web-pubsub-client": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "otpauth": "^9.5.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
